<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <AssemblyName>IPGeolocation</AssemblyName>
    <RootNamespace>IPGeolocation</RootNamespace>
    <PackageId>IPGeoLocation.IPGeolocation</PackageId>
    <Version>3.0.0</Version>
    <Authors>IPGeolocation.io</Authors>
    <Company>IPGeolocation.io</Company>
    <AssemblyTitle>IPGeolocation .NET SDK</AssemblyTitle>
    <Description>Official .NET SDK for the IPGeolocation.io IP Location API with single and bulk lookup, typed responses, and raw JSON or XML support.</Description>
    <PackageReleaseNotes>Replaced the old generated multi-API SDK with the new .NET SDK for the IPGeolocation.io IP Location API.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://ipgeolocation.io</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ipgeolocation;geolocation;ip;ip-location;ip-geolocation;ip-lookup;dotnet;csharp;sdk;api-client;ipv4;ipv6;domain-lookup;timezone;hostname;user-agent;asn;security;proxy-detection;bulk-lookup</PackageTags>
    <RepositoryUrl>https://github.com/IPGeolocation/ip-geolocation-api-dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Internal\**\*.cs" />
    <Compile Include="Properties\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" Link="README.md" />
  </ItemGroup>

</Project>
